# Copy to .env.local for local development. Never commit real values.

# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Defaults to http://localhost:3000 if omitted; set to the deployed URL in Vercel.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Not required by the app yet (Module 1/2 don't use it at runtime) —
# keep it out of Vercel until a feature actually needs it, and never in a Client Component.
# SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Shift report narrative written by Claude (/reports). Optional: without it,
# the structured non-AI report is generated instead. Never prefix with NEXT_PUBLIC.
# ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5). E.g. claude-haiku-4-5 for lower cost.
# ANTHROPIC_MODEL=

# Server-only. Google Sheets export (tours + income). Without these, entries stay queued.
# Base64 of the service account JSON key file (share both sheets with its client_email as Editor).
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SHEETS_TOURS_ID=14CZDE7UpuA7jVgNjcgfpc6vNVccS2bTt6BswY1UhJX8
# GOOGLE_SHEETS_INCOME_ID=1cWSj5UfRDeME9nnYVp3N_DmkmN500FeFYcKAQr_jz6E
# Rows go to monthly tabs named SEPTIEMBRE2026, OCTUBRE2026, ... (created with headers when missing).
# Used by the sender only (bypasses RLS). Never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=
# Protects /api/sheets/flush (Vercel Cron sends it as a Bearer token).
# CRON_SECRET=
