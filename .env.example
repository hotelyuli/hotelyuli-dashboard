# Copy to .env.local for local development. Never commit real values.

# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Defaults to http://localhost:3000 if omitted; set to the deployed URL in Vercel.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Not required by the app yet (Module 1/2 don't use it at runtime) —
# keep it out of Vercel until a feature actually needs it, and never in a Client Component.
# SUPABASE_SERVICE_ROLE_KEY=
